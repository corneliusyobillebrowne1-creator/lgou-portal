<%- include('../partials/header') %>
<main><div class="wrap">
  <h1>My courses</h1>
  <% if (courses.length) { %>
  <div class="tablewrap"><table>
    <thead><tr><th>Course</th><th>Type</th><th>Fee</th><th>Status</th><th>Enrolled</th><th></th></tr></thead>
    <tbody>
    <% courses.forEach(c => { %>
      <tr><td><%= c.title %></td><td><span class="badge <%= c.type === 'diploma' ? 'diploma' : '' %>"><%= c.type %></span></td><td><%= money(c.fee_cents) %></td>
      <td><span class="badge <%= c.approval_status === 'approved' ? 'ok' : c.approval_status === 'pending' ? 'warn' : 'bad' %>"><%= c.approval_status %></span>
        <% if (c.admin_note) { %><br><span class="muted">Note: <%= c.admin_note %></span><% } %></td>
      <td><%= c.enrolled %></td><td><a class="btn small" href="/teacher/courses/<%= c.id %>">Manage</a></td></tr>
    <% }) %>
    </tbody>
  </table></div>
  <% } %>

  <h2>Create a new course</h2>
  <form method="post" action="/teacher/courses" class="card">
    <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
    <%- include('course_fields', { c: { title: '', type: 'certificate', summary: '', description: '', fee_cents: 1000, duration_weeks: 4, pass_mark: 50, active: 1, classroom_url: '' } }) %>
    <p class="muted">New courses are reviewed by the admin team before they appear on the website.</p>
    <p><button class="btn red" type="submit">Submit course for approval</button></p>
  </form>
</div></main>
<%- include('../partials/footer') %>
