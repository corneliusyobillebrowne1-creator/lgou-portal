<%- include('../partials/header') %>
<main><div class="wrap">
  <h1>Payments</h1>
  <div class="actions">
    <a class="btn small <%= status === 'pending' ? '' : 'ghost' %>" href="/admin/payments?status=pending">To confirm</a>
    <a class="btn small <%= status === 'confirmed' ? '' : 'ghost' %>" href="/admin/payments?status=confirmed">Confirmed</a>
    <a class="btn small <%= status === 'rejected' ? '' : 'ghost' %>" href="/admin/payments?status=rejected">Rejected</a>
  </div>
  <p class="muted">Check each transaction reference against your mobile-money / bank statement before confirming.</p>
  <% if (!payments.length) { %><p>No <%= status %> payments.</p><% } else { %>
  <div class="tablewrap"><table>
    <thead><tr><th>Date</th><th>Student</th><th>Course</th><th>Amount</th><th>Method</th><th>Reference</th><th></th></tr></thead>
    <tbody>
    <% payments.forEach(p => { %>
      <tr>
        <td><%= fmtDate(p.created_at) %></td>
        <td><a href="/admin/students/<%= p.user_id %>"><%= p.full_name %></a><br><span class="muted"><%= p.username %></span></td>
        <td><%= p.course_title %><br><span class="muted">fee <%= money(p.fee_cents) %><%= p.teacher_name ? ' · teacher: ' + p.teacher_name : '' %></span></td>
        <td><%= money(p.amount_cents) %></td><td><%= p.method %></td><td><%= p.reference %></td>
        <td>
          <% if (p.status === 'pending') { %>
            <div class="actions">
              <form method="post" action="/admin/payments/<%= p.id %>/confirmed" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken() %>"><button class="btn small ok" type="submit">Confirm</button></form>
              <form method="post" action="/admin/payments/<%= p.id %>/rejected" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken() %>"><button class="btn small red" type="submit">Reject</button></form>
            </div>
          <% } else { %><span class="badge <%= p.status === 'confirmed' ? 'ok' : 'bad' %>"><%= p.status %></span><% } %>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table></div>
  <% } %>
</div></main>
<%- include('../partials/footer') %>
