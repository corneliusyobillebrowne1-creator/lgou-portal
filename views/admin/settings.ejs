<%- include('../partials/header') %>
<main><div class="wrap">
  <h1>Settings &amp; backups</h1>

  <h2>Payment instructions shown to students</h2>
  <form method="post" action="/admin/settings" class="card">
    <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
    <label for="instructions">Tell students where to send their fees (mobile money numbers, bank details, office address)</label>
    <textarea id="instructions" name="instructions" maxlength="2000"><%= instructions %></textarea>
    <label for="methods">Payment methods (one per line: <code>Name | details students should use</code>)</label>
    <textarea id="methods" name="methods" rows="6" maxlength="2500" placeholder="Orange Money | Send to 0770 000 000 (name: School Office)&#10;Bank transfer | Bank, account name, account number"><%= methodsText %></textarea>
    <p class="muted">These appear on the student payment page and in the payment method list. Example: <code>MTN Mobile Money | 0880 000 000, name Liberia Gateway</code>. Only enter account details you want students to see.</p>
    <label for="max_fee">Maximum fee a teacher may charge for one course (USD)</label>
    <input type="text" id="max_fee" name="max_fee" inputmode="decimal" value="<%= maxFee %>">
    <p><button class="btn" type="submit">Save</button></p>
  </form>

  <h2>College information shown to the public</h2>
  <form method="post" action="/admin/settings" class="card">
    <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
    <label for="college_contact">Contact details (address, phone, email, office hours)</label>
    <textarea id="college_contact" name="college_contact" maxlength="600"><%= site.contact %></textarea>
    <label for="admission_requirements">Entry requirements (shown on the Admissions page)</label>
    <textarea id="admission_requirements" name="admission_requirements" maxlength="1500"><%= site.admissions %></textarea>
    <label for="accreditation_statement">Recognition / accreditation statement (shown on the About page)</label>
    <textarea id="accreditation_statement" name="accreditation_statement" maxlength="1200"><%= site.accreditation %></textarea>
    <p class="muted">Only state accreditation or government recognition if the college really holds it.</p>
    <p><button class="btn" type="submit">Save college information</button></p>
  </form>

  <h2>Email (receipts and certificates)</h2>
  <form method="post" action="/admin/settings" class="card" autocomplete="off">
    <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
    <p>Status: <strong><%= mail.ready ? 'Ready. Students get receipts and certificates by email.' : 'Not set up. No emails are sent yet.' %></strong></p>
    <p class="muted">Recommended: a free <strong>Brevo</strong> account (brevo.com). Verify your sender email there, create an API key, and paste it below. It works on free hosting. Any normal SMTP mail server also works (some free hosts block SMTP).</p>
    <label for="email_provider">How to send</label>
    <select id="email_provider" name="email_provider">
      <option value="off" <%= mail.provider === 'off' ? 'selected' : '' %>>Off</option>
      <option value="brevo" <%= mail.provider === 'brevo' ? 'selected' : '' %>>Brevo (HTTPS API) - recommended</option>
      <option value="smtp" <%= mail.provider === 'smtp' ? 'selected' : '' %>>SMTP server</option>
    </select>
    <label for="email_from_name">Sender name</label><input type="text" id="email_from_name" name="email_from_name" maxlength="80" value="<%= mail.fromName %>">
    <label for="email_from_address">Sender email address (must be verified with your email service)</label><input type="email" id="email_from_address" name="email_from_address" maxlength="254" value="<%= mail.fromEmail %>">
    <label for="email_brevo_key">Brevo API key <%= mail.hasBrevoKey ? '(saved - leave empty to keep it)' : '' %></label><input type="password" id="email_brevo_key" name="email_brevo_key" autocomplete="off" placeholder="<%= mail.hasBrevoKey ? '••••••••' : 'xkeysib-...' %>">
    <details><summary>SMTP settings (only if you chose SMTP)</summary>
      <label for="smtp_host">SMTP host</label><input type="text" id="smtp_host" name="smtp_host" maxlength="200" value="<%= mail.smtp.host %>" placeholder="smtp.example.com">
      <label for="smtp_port">Port</label><input type="number" id="smtp_port" name="smtp_port" value="<%= mail.smtp.port %>">
      <label><input type="checkbox" name="smtp_secure" value="1" <%= mail.smtp.secure ? 'checked' : '' %>> Use SSL/TLS (usually port 465)</label>
      <label for="smtp_user">SMTP username</label><input type="text" id="smtp_user" name="smtp_user" maxlength="200" value="<%= mail.smtp.user %>" autocomplete="off">
      <label for="smtp_pass">SMTP password <%= mail.hasSmtpPass ? '(saved - leave empty to keep it)' : '' %></label><input type="password" id="smtp_pass" name="smtp_pass" autocomplete="off">
    </details>
    <p><button class="btn" type="submit">Save email settings</button> <a class="btn ghost" href="/admin/emails">View sent emails</a></p>
  </form>
  <form method="post" action="/admin/email/test" class="card">
    <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
    <label for="test_to">Send a test email to</label><input type="email" id="test_to" name="to" required maxlength="254">
    <p><button class="btn" type="submit">Send test email</button></p>
  </form>

  <h2>Database backups</h2>
  <div class="card">
    <p>A backup is created automatically every 24 hours (newest 14 are kept in the <code>backups</code> folder). You can also make one now.</p>
    <form method="post" action="/admin/backup"><input type="hidden" name="_csrf" value="<%= csrfToken() %>"><button class="btn" type="submit">Back up now</button></form>
    <p class="muted">Copy backup files off this server regularly (cloud storage, external drive). Personal data inside is encrypted, so also keep a copy of the encryption key (<code>data/.enc.key</code> or your <code>ENCRYPTION_KEY</code>) in a separate safe place &mdash; without it a backup cannot be restored to readable data.</p>
    <% if (!backups.length) { %><p>No backups yet.</p><% } else { %>
    <div class="tablewrap"><table>
      <thead><tr><th>File</th><th>Created</th><th>Size</th></tr></thead>
      <tbody><% backups.forEach(b => { %><tr><td><%= b.name %></td><td><%= b.mtime.toISOString().replace('T', ' ').slice(0, 19) %> UTC</td><td><%= Math.round(b.size / 1024) %> KB</td></tr><% }) %></tbody>
    </table></div>
    <% } %>
  </div>
</div></main>
<%- include('../partials/footer') %>
