<%- include('../partials/header') %>
<main><div class="wrap">
  <h1>Announcements</h1>
  <p class="muted">Shown on the public homepage (latest 3) and on every student's portal.</p>
  <form method="post" action="/admin/announcements" class="card">
    <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
    <label for="title">Title</label><input type="text" id="title" name="title" maxlength="120" required>
    <label for="body">Message (optional)</label><textarea id="body" name="body" maxlength="1000"></textarea>
    <p><button class="btn" type="submit">Publish</button></p>
  </form>
  <% if (!items.length) { %><p class="muted">No announcements yet.</p><% } else { %>
  <div class="tablewrap"><table>
    <thead><tr><th>Date</th><th>Title</th><th></th></tr></thead>
    <tbody><% items.forEach(n => { %><tr><td><%= fmtDate(n.created_at) %></td><td><strong><%= n.title %></strong><br><span class="muted"><%= n.body %></span></td>
      <td><form method="post" action="/admin/announcements/<%= n.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken() %>"><button class="btn ghost" type="submit">Delete</button></form></td></tr><% }) %></tbody>
  </table></div>
  <% } %>
</div></main>
<%- include('../partials/footer') %>
