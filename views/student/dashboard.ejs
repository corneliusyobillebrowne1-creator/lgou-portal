<%- include('../partials/header') %>
<%
const ic = (d) => '<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + d + '</svg>';
const I = { cal: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/>', doc: '<path d="M6 3h9l4 4v14H6z"/><path d="M14 3v5h5M9 13h7M9 17h7"/>', user: '<circle cx="12" cy="8" r="4"/><path d="M4 21c1-5 15-5 16 0"/>', book: '<path d="M4 4h7a3 3 0 0 1 3 3v14a2 2 0 0 0-2-2H4zM20 4h-6v15h6z"/>', plus: '<circle cx="12" cy="12" r="9"/><path d="M12 8v8M8 12h8"/>', people: '<circle cx="9" cy="8" r="3.5"/><path d="M2 20c1-5 13-5 14 0M17 5a3.5 3.5 0 0 1 0 7M18 14c3 .5 4 3 4 6"/>', cash: '<rect x="3" y="6" width="18" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/>', check: '<circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/>' };
%>
<main><div class="wrap">
  <div class="welcome">
    <div>
      <h1>Welcome, <%= user.full_name %></h1>
      <p>Your learning, payments and certificates are all here.</p>
      <% if (user.student_no) { %><span class="idbadge">Student no. <%= user.student_no %></span><% } %>
    </div>
  </div>
  <div class="stats quick">
    <div class="stat"><b><%= enrollments.length %></b><span>My courses</span></div>
    <div class="stat good"><b><%= enrollments.filter(e => e.status === 'certified').length %></b><span>Certificates earned</span></div>
    <div class="stat <%= enrollments.some(e => e.owed_cents > 0) ? 'alertish' : 'good' %>"><b><%= money(enrollments.reduce((a, e) => a + e.owed_cents, 0)) %></b><span>Fees still to pay</span></div>
  </div>
  <div class="tiles">
    <a class="tile" href="/portal/schedule"><%- ic(I.cal) %>Class timetable<small>When your classes happen</small></a>
    <a class="tile" href="/portal/transcript"><%- ic(I.doc) %>My transcript<small>Courses &amp; results</small></a>
    <a class="tile" href="#available"><%- ic(I.plus) %>Find a course<small>Enroll in something new</small></a>
    <a class="tile" href="/account"><%- ic(I.user) %>My account<small>Password &amp; details</small></a>
  </div>
  <% if (news.length) { %>
  <div class="card flat news"><h3>College announcements</h3>
    <% news.forEach(n => { %><p><strong><%= n.title %></strong> <span class="muted">(<%= fmtDate(n.created_at) %>)</span><% if (n.body) { %><br><span class="pre"><%= n.body %></span><% } %></p><% }) %>
  </div>
  <% } %>

  <h2>My courses</h2>
  <% if (!enrollments.length) { %>
    <div class="card flat"><p>You are not enrolled in any course yet. Pick one below to get started.</p></div>
  <% } %>
  <div class="grid">
  <% enrollments.forEach(e => { %>
    <article class="card">
      <span class="badge <%= badgeClass(e.course_type) %>"><%= typeLabel(e.course_type) %></span>
      <% if (e.has_classroom) { %><span class="badge ok">Live classes</span><% } %>
      <h3><%= e.course_title %></h3>
      <% if (e.class_schedule) { %><p class="meta"><strong>Class times:</strong> <%= e.class_schedule %></p><% } %>
      <p class="meta">Fee <%= money(e.fee_cents) %> &middot; Paid <%= money(e.paid_cents) %>
        <% if (e.owed_cents > 0) { %>&middot; <strong>Balance <%= money(e.owed_cents) %></strong><% } %></p>

      <% if (!e.paid_full) { %>
        <% if (e.pending_cents > 0) { %><p><span class="badge warn">Payment awaiting confirmation</span></p><% } else { %><p><span class="badge bad">Fee not paid</span></p><% } %>
        <a class="btn" href="/portal/pay/<%= e.id %>"><%= e.pending_cents > 0 ? 'Payment details' : 'Pay fee' %></a>
      <% } else { %>
        <% if (e.lesson_total > 0) { %>
          <p><progress value="<%= e.percent %>" max="100"></progress><br><span class="meta"><%= e.percent %>% done (<%= e.lesson_done %>/<%= e.lesson_total %> lessons)</span></p>
        <% } %>
        <div class="actions">
          <% if (e.has_classroom) { %><a class="btn red" href="/portal/classroom/<%= e.id %>" target="_blank" rel="noopener noreferrer">Join Google Classroom</a><% } %>
          <% if (e.lesson_total > 0) { %><a class="btn" href="/portal/learn/<%= e.id %>"><%= e.lesson_done ? 'Continue lessons' : 'Start lessons' %></a><% } %>
          <% if (e.teacher_id) { %><a class="btn ghost" href="/portal/results/<%= e.id %>">Attendance &amp; grades</a><% } %>
          <a class="btn ghost" href="/portal/qa/<%= e.id %>">Ask a question<%= reviewed.has(e.id) ? '' : ' / Rate' %></a>
          <% if (e.status === 'enrolled' && e.eligible) { %>
            <form method="post" action="/portal/request-certificate/<%= e.id %>" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken() %>"><button class="btn red" type="submit">Request certificate</button></form>
          <% } %>
          <% if (e.status === 'requested') { %><span class="badge warn">Certificate request under review</span><% } %>
          <% if (e.status === 'certified') { %><a class="btn ok" href="/portal/certificate/<%= e.id %>">View certificate</a>
            <form method="post" action="/portal/email-certificate/<%= e.id %>" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken() %>"><button class="btn ghost" type="submit">Email me a copy</button></form><% } %>
        </div>
        <% if (e.teacher_id && e.status === 'enrolled' && !e.eligible) { %><p class="muted">Your teacher will recommend you for the certificate when you have completed the course.</p><% } %>
        <% if (e.status === 'enrolled' && e.request_note) { %><p class="alert warn">School note: <%= e.request_note %></p><% } %>
      <% } %>
    </article>
  <% }) %>
  </div>

  <h2 id="invite">Invite your friends</h2>
  <div class="card flat">
    <p>Share the college with friends. <strong><%= invite.joined %></strong> friend<%= invite.joined === 1 ? '' : 's' %> joined with your link.</p>
    <p><input type="text" readonly value="<%= invite.link %>"></p>
    <% const imsg = encodeURIComponent('Study online at Liberia Gateway Online College: ' + invite.link); %>
    <div class="actions"><a class="btn small" href="https://wa.me/?text=<%= imsg %>" target="_blank" rel="noopener noreferrer">Share on WhatsApp</a>
    <a class="btn small ghost" href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(invite.link) %>" target="_blank" rel="noopener noreferrer">Share on Facebook</a></div>
  </div>

  <h2 id="available">Available courses</h2>
  <% if (!available.length) { %><p class="muted">You are enrolled in every available course.</p><% } %>
  <div class="grid">
  <% available.forEach(c => { %>
    <article class="card">
      <span class="badge <%= badgeClass(c.type) %>"><%= typeLabel(c.type) %></span>
      <% if (c.live) { %><span class="badge ok">Live classes</span><% } %>
      <% if (!c.ready) { %><span class="badge warn">Coming soon</span><% } %>
      <h3><%= c.title %></h3>
      <p><%= c.summary %></p>
      <% if (c.teacher_name) { %><p class="meta">Taught by <%= c.teacher_name %></p><% } %>
      <div class="price"><%= money(c.fee_cents) %></div>
      <div class="actions">
        <a class="btn ghost" href="/courses/<%= c.id %>">Details</a>
        <% if (c.ready) { %><form method="post" action="/portal/enroll/<%= c.id %>" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken() %>"><button class="btn" type="submit">Enroll</button></form><% } %>
      </div>
    </article>
  <% }) %>
  </div>
</div></main>
<%- include('../partials/footer') %>
