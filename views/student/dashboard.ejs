<%- include('../partials/header') %>
<main><div class="wrap">
  <h1>Welcome, <%= user.full_name %></h1>

  <h2>My courses</h2>
  <% if (!enrollments.length) { %>
    <div class="card flat"><p>You are not enrolled in any course yet. Pick one below to get started.</p></div>
  <% } %>
  <div class="grid">
  <% enrollments.forEach(e => { %>
    <article class="card">
      <span class="badge <%= e.course_type === 'diploma' ? 'diploma' : '' %>"><%= e.course_type %></span>
      <% if (e.has_classroom) { %><span class="badge ok">Live classes</span><% } %>
      <h3><%= e.course_title %></h3>
      <p class="meta">Fee <%= money(e.fee_cents) %> &middot; Paid <%= money(e.paid_cents) %>
        <% if (e.owed_cents > 0) { %>&middot; <strong>Balance <%= money(e.owed_cents) %></strong><% } %></p>

      <% if (!e.paid_full) { %>
        <% if (e.pending_cents > 0) { %><p><span class="badge warn">Payment awaiting confirmation</span></p><% } else { %><p><span class="badge bad">Fee not paid</span></p><% } %>
        <a class="btn" href="/portal/pay/<%= e.id %>"><%= e.pending_cents > 0 ? 'Payment details' : 'Pay fee' %></a>
      <% } else { %>
        <% if (e.lesson_total > 0) { %>
          <p><progress value="<%= e.percent %>" max="100"></progress> <%= e.percent %>% (<%= e.lesson_done %>/<%= e.lesson_total %> lessons)</p>
        <% } %>
        <div class="actions">
          <% if (e.has_classroom) { %><a class="btn red" href="/portal/classroom/<%= e.id %>" target="_blank" rel="noopener noreferrer">Join Google Classroom</a><% } %>
          <% if (e.lesson_total > 0) { %><a class="btn" href="/portal/learn/<%= e.id %>"><%= e.lesson_done ? 'Continue lessons' : 'Start lessons' %></a><% } %>
          <% if (e.teacher_id) { %><a class="btn ghost" href="/portal/results/<%= e.id %>">Attendance &amp; grades</a><% } %>
          <% if (e.status === 'enrolled' && e.eligible) { %>
            <form method="post" action="/portal/request-certificate/<%= e.id %>" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken() %>"><button class="btn red" type="submit">Request certificate</button></form>
          <% } %>
          <% if (e.status === 'requested') { %><span class="badge warn">Certificate request under review</span><% } %>
          <% if (e.status === 'certified') { %><a class="btn ok" href="/portal/certificate/<%= e.id %>">View certificate</a><% } %>
        </div>
        <% if (e.teacher_id && e.status === 'enrolled' && !e.eligible) { %><p class="muted">Your teacher will recommend you for the certificate when you have completed the course.</p><% } %>
        <% if (e.status === 'enrolled' && e.request_note) { %><p class="alert warn">School note: <%= e.request_note %></p><% } %>
      <% } %>
    </article>
  <% }) %>
  </div>

  <h2>Available courses</h2>
  <% if (!available.length) { %><p class="muted">You are enrolled in every available course.</p><% } %>
  <div class="grid">
  <% available.forEach(c => { %>
    <article class="card">
      <span class="badge <%= c.type === 'diploma' ? 'diploma' : '' %>"><%= c.type %></span>
      <% if (c.live) { %><span class="badge ok">Live classes</span><% } %>
      <% if (!c.ready) { %><span class="badge warn">Coming soon</span><% } %>
      <h3><%= c.title %></h3>
      <p><%= c.summary %></p>
      <% if (c.teacher_name) { %><p class="meta">Taught by <%= c.teacher_name %></p><% } %>
      <div class="price"><%= money(c.fee_cents) %></div>
      <div class="actions">
        <a class="btn ghost" href="/courses/<%= c.id %>">Details</a>
        <% if (c.ready) { %><form method="post" action="/portal/enroll/<%= c.id %>" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken() %>"><button class="btn" type="submit">Enroll</button></form><% } %>
      </div>
    </article>
  <% }) %>
  </div>
</div></main>
<%- include('../partials/footer') %>
