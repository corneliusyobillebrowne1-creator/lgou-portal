<%- include('../partials/header') %>
<main><div class="wrap">
  <p><a href="/portal">&larr; My portal</a></p>
  <h1>Attendance &amp; grades</h1>
  <p class="muted"><%= e.course_title %> &middot; recorded by your teacher</p>
  <div class="stats">
    <div class="stat"><b><%= attPct === null ? '-' : attPct + '%' %></b><span>Attendance</span></div>
    <div class="stat"><b><%= gradePct === null ? '-' : gradePct + '%' %></b><span>Grade average</span></div>
  </div>

  <h2>Grades</h2>
  <% if (!grades.length) { %><p class="muted">No quizzes or assignments have been set up yet.</p><% } else { %>
  <div class="tablewrap"><table>
    <thead><tr><th>Item</th><th>Type</th><th>Score</th></tr></thead>
    <tbody>
    <% grades.forEach(g => { %><tr><td><%= g.title %></td><td><%= g.category %></td><td><%= g.score === null ? 'not graded yet' : g.score + ' / ' + g.max_score %></td></tr><% }) %>
    </tbody>
  </table></div>
  <% } %>

  <h2>Attendance</h2>
  <% if (!attendance.length) { %><p class="muted">No class sessions recorded yet.</p><% } else { %>
  <div class="tablewrap"><table>
    <thead><tr><th>Date</th><th>Topic</th><th>Status</th></tr></thead>
    <tbody>
    <% attendance.forEach(a => { %><tr><td><%= a.session_date %></td><td><%= a.topic || '-' %></td>
      <td><% if (a.status) { %><span class="badge <%= a.status === 'present' ? 'ok' : a.status === 'absent' ? 'bad' : 'warn' %>"><%= a.status %></span><% } else { %><span class="muted">not marked</span><% } %></td></tr><% }) %>
    </tbody>
  </table></div>
  <% } %>
</div></main>
<%- include('../partials/footer') %>
