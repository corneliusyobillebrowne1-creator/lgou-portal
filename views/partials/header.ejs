<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= typeof title !== 'undefined' && title ? title + ' · ' : '' %>Liberia Gateway Online College</title>
<link rel="stylesheet" href="/style.css">
<link rel="icon" type="image/png" href="/logo.png">
</head>
<body>
<% if (siteInfo.phones.length) { %><div class="topbar">Questions? Call <% siteInfo.phones.forEach((p, i) => { %><%= i ? ' or ' : '' %><a href="tel:<%= p.tel %>"><%= p.show %></a><% }) %></div><% } %>
<header class="site-header">
  <div class="bar">
    <a class="brand" href="/"><img class="logo" src="/logo.png" alt="Liberia Gateway Online College logo" width="52" height="52"><span>Liberia Gateway<br><small>Online College</small></span></a>
    <nav>
      <a href="/">Home</a>
      <a href="/#courses">Programmes</a>
      <a href="/admissions">Admissions</a>
      <a href="/teachers">Teachers</a>
      <a href="/about">About</a>
      <a href="/teach">Teach with us</a>
      <a href="/verify">Verify</a>
      <% if (user) { %>
        <a href="<%= homeFor(user) %>"><%= user.role === 'admin' ? 'Admin' : user.role === 'teacher' ? 'Teacher area' : 'My Portal' %></a>
        <a href="/account">Account</a>
        <form method="post" action="/logout" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken() %>"><button class="linkbtn" type="submit">Log out (<%= user.username %>)</button></form>
      <% } else { %>
        <a href="/login">Log in</a>
        <a href="/signup">Apply / Sign up</a>
      <% } %>
    </nav>
  </div>
</header>
<% if (user && user.role === 'admin') { %>
<div class="subnav"><div class="wrap">
  <a href="/admin" class="<%= currentPath === '/admin' || currentPath === '/admin/' ? 'on' : '' %>">Dashboard</a>
  <a href="/admin/students" class="<%= currentPath.startsWith('/admin/students') ? 'on' : '' %>">Students</a>
  <a href="/admin/teachers" class="<%= currentPath.startsWith('/admin/teachers') ? 'on' : '' %>">Teachers</a>
  <a href="/admin/payments" class="<%= currentPath.startsWith('/admin/payments') ? 'on' : '' %>">Payments</a>
  <a href="/admin/course-approvals" class="<%= currentPath.startsWith('/admin/course-approvals') ? 'on' : '' %>">Course approvals</a>
  <a href="/admin/courses" class="<%= currentPath.startsWith('/admin/courses') ? 'on' : '' %>">Courses &amp; YouTube</a>
  <a href="/admin/approvals" class="<%= currentPath.startsWith('/admin/approvals') ? 'on' : '' %>">Completions</a>
  <a href="/admin/certificates" class="<%= currentPath.startsWith('/admin/certificates') ? 'on' : '' %>">Certificates</a>
  <a href="/admin/emails" class="<%= currentPath.startsWith('/admin/emails') ? 'on' : '' %>">Emails</a>
  <a href="/admin/announcements" class="<%= currentPath.startsWith('/admin/announcements') ? 'on' : '' %>">Announcements</a>
  <a href="/admin/assistant" class="<%= currentPath.startsWith('/admin/assistant') ? 'on' : '' %>">AI assistant</a>
  <a href="/admin/settings" class="<%= currentPath.startsWith('/admin/settings') ? 'on' : '' %>">Settings &amp; Backups</a>
</div></div>
<% } %>
<% if (user && user.role === 'teacher' && teacher && teacher.status === 'approved') { %>
<div class="subnav"><div class="wrap">
  <a href="/teacher" class="<%= currentPath === '/teacher' || currentPath === '/teacher/' ? 'on' : '' %>">Dashboard</a>
  <a href="/teacher/courses" class="<%= currentPath.startsWith('/teacher/courses') ? 'on' : '' %>">My courses</a>
  <a href="/teacher/profile" class="<%= currentPath.startsWith('/teacher/profile') ? 'on' : '' %>">My public profile</a>
</div></div>
<% } %>
<% if (flash) { %><div class="wrap"><div class="alert <%= flash.type %>"><%= flash.msg %></div></div><% } %>
