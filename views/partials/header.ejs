<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<link rel="manifest" href="/manifest.webmanifest">
<meta name="theme-color" content="#0b2a5b">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="LGOC">
<title><%= typeof title !== 'undefined' && title ? title + ' · ' : '' %>Liberia Gateway Online College</title>
<link rel="stylesheet" href="/style.css">
<link rel="icon" type="image/png" href="/logo.png">
</head>
<body class="<%= user && (user.role !== 'teacher' || (teacher && teacher.status === 'approved')) ? 'has-bottom role-' + user.role : '' %>">
<% if (siteInfo.phones.length) { %><div class="topbar">Questions? Call <% siteInfo.phones.forEach((p, i) => { %><%= i ? ' or ' : '' %><a href="tel:<%= p.tel %>"><%= p.show %></a><% }) %></div><% } %>
<header class="site-header">
  <div class="bar">
    <a class="brand" href="/"><img class="logo" src="/logo.png" alt="Liberia Gateway Online College logo" width="52" height="52"><span>Liberia Gateway<br><small>Online College</small></span></a>
    <button class="navtoggle" id="navtoggle" type="button" aria-expanded="false" aria-controls="mainnav"><span class="bars"></span><span class="sr">Menu</span></button>
    <nav id="mainnav">
      <a href="/">Home</a>
      <a href="/#courses">Programmes</a>
      <a href="/admissions">Admissions</a>
      <a href="/teachers">Teachers</a>
      <a href="/about">About</a>
      <a href="/teach">Teach with us</a>
      <a href="/verify">Verify</a>
      <% if (user) { %>
        <a href="<%= homeFor(user) %>"><%= user.role === 'admin' ? 'Admin' : user.role === 'teacher' ? 'Teacher area' : 'My Portal' %></a>
        <a href="/account">Account</a>
        <form method="post" action="/logout" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken() %>"><button class="linkbtn" type="submit">Log out (<%= user.username %>)</button></form>
      <% } else { %>
        <a href="/login">Log in</a>
        <a href="/signup">Apply / Sign up</a>
      <% } %>
    </nav>
  </div>
</header>
<%- include('portalnav') %>
<% if (flash) { %><div class="wrap"><div class="alert <%= flash.type %>"><%= flash.msg %></div></div><% } %>
