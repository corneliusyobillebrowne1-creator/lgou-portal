<article class="card coursecard" data-title="<%= (c.title + ' ' + c.type + ' ' + (c.summary || '')).toLowerCase() %>">
  <span class="badge <%= badgeClass(c.type) %>"><%= typeLabel(c.type) %></span>
  <% if (c.live) { %><span class="badge ok">Live classes</span><% } %>
  <% if (!c.ready) { %><span class="badge warn">Coming soon</span><% } %>
  <h3><%= c.title %></h3>
  <p><%= c.summary %></p>
  <p class="meta">
    <%= durationLabel(c.duration_weeks) %>
    <% if (c.lesson_count) { %>&middot; <%= c.lesson_count %> video lessons<% } %>
    <% if (c.teacher_name) { %><br>Taught by <%= c.teacher_name %><% } %>
  </p>
  <div class="price"><%= money(c.fee_cents) %></div>
  <a class="btn" href="/courses/<%= c.id %>">View course</a>
</article>
